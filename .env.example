APP_NAME="Caraka Muda UPI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set to your Koyeb/production domain, e.g. https://caraka-muda-xxxx.koyeb.app
APP_URL=https://your-app.koyeb.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Use the "Transaction" pooler (port 5432) for serverless/container deployments.
# Connection string is at: Supabase dashboard → Project → Settings → Database → Connection string
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require

# ─── Session & Cache ─────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── File Storage (Supabase Storage / S3-compatible) ─────────────────────────
# Set FILESYSTEM_DISK=supabase to use Supabase Storage (default is local disk).
# Leave as "local" for local development.
FILESYSTEM_DISK=supabase

# Credentials are from: Supabase dashboard → Storage → S3 Connection
# Make sure your storage bucket is set to PUBLIC in the Supabase dashboard.
#
# AWS_ACCESS_KEY_ID   = S3 Access Key from Supabase S3 Connection page
# AWS_SECRET_ACCESS_KEY = S3 Secret Key from Supabase S3 Connection page
# AWS_DEFAULT_REGION  = region shown on S3 Connection page (e.g. ap-southeast-1)
# AWS_BUCKET          = name of the bucket you created in Supabase Storage
# AWS_ENDPOINT        = https://<project-ref>.supabase.co/storage/v1/s3
# AWS_URL             = public file base URL (used by Storage::url() in models):
#                       https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@carakamuda.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
